    "decoder": 0,
    "frameDetection": 1,
    "frameEnd": "*/",
    "frameParser": "/**\n * Cryocooler Controller Telemetry Parser\n *\n * Parses pipe-delimited telemetry frames from the ESP32-S3 cryocooler\n * controller (35 fields, Serial Studio wire format).\n *\n * INPUT FIELDS (0-indexed):\n *   0  state.id                 1  state.name\n *   2  state.status_text        3  temperature.k\n *   4  temperature.c            5  temperature.ambient_c\n *   6  temperature.cooling_rate 7  dac.target\n *   8  dac.actual               9  rms.voltage\n *  10  relay.normal            11  relay.alarm\n *  12  indicator.fault         13  indicator.ready\n *  14  status.on_duration_ms   15  status.on_duration\n *  16  temperature.cooldown_pct 17 status.time_in_state\n *  18  rms.current_a           19  status.backoff_count\n *  20  temperature.delta_below_ambient_c\n *  21  voltage.v               22  voltage.raw\n *  23  waveform.status         24  waveform.frequency_hz\n *  25  accel.roll_deg          26  accel.pitch_deg\n *  27  accel.yaw_deg           28  accel.accel_mag\n *  29  accel.gyro_mag          30  accel.temp_c\n *  31  accel.motion            32  accel.x\n *  33  accel.y                 34  accel.z\n *\n * OUTPUT ARRAY (32 elements, 1-indexed by dataset index):\n *   1  stateNo       2  stateName     3  stateNameNum\n *   4  tempK         5  tempC         6  coolingRate\n *   7  dacTarget     8  dacActual     9  rmsV\n *  10  relayNormal  11  alarmRelay   12  redLed\n *  13  greenLed     14  onDurationMs 15  onDuration\n *  16  stateText    17  cooldownPct  18  timeInState\n *  19  ambientTempC 20  currentA     21  backoffCount\n *  22  tempBelowAmbient\n *  23  rollDeg      24  pitchDeg     25  yawDeg\n *  26  accelMag     27  gyroMag      28  imuTempC\n *  29  motion       30  accelX       31  accelY\n *  32  accelZ\n */\n\nconst stateNameToNumber = {\n    \"Off\":            -1,\n    \"Initialize\":     0,\n    \"Idle\":           1,\n    \"CoarseCooldown\": 2,\n    \"FineCooldown\":   3,\n    \"Overshoot\":      4,\n    \"Settle\":         5,\n    \"Baseline\":       6,\n    \"Operating\":      7,\n    \"Fault\":          8\n};\n\nfunction parse(frame) {\n    const fields = frame.split(\"|\");\n    if (fields.length < 30) return [];\n\n    const stateNo        = parseInt(fields[0]);\n    const stateName      = fields[1].trim();\n    const stateNameNum   = stateNameToNumber.hasOwnProperty(stateName)\n                             ? stateNameToNumber[stateName]\n                             : stateNo;\n    const stateText      = fields[2];\n    const tempK          = parseFloat(fields[3]);\n    const tempC          = parseFloat(fields[4]);\n    const ambientTempC   = parseFloat(fields[5]);\n    const coolingRate    = parseFloat(fields[6]);\n    const dacTarget      = parseFloat(fields[7]);\n    const dacActual      = parseFloat(fields[8]);\n    const rmsV           = parseFloat(fields[9]);\n    const relayNormal    = parseInt(fields[10]);\n    const alarmRelay     = parseInt(fields[11]);\n    const redLed         = parseInt(fields[12]);\n    const greenLed       = parseInt(fields[13]);\n    const onDurationMs   = parseInt(fields[14]);\n    const onDuration     = fields[15];\n    const cooldownPct    = fields[16];\n    const timeInState    = fields[17];\n    const currentA       = parseFloat(fields[18]);\n    const backoffCount   = parseInt(fields[19]);\n    const tempBelowAmbient = parseFloat(fields[20]);\n    const rollDeg        = parseFloat(fields[25]);\n    const pitchDeg       = parseFloat(fields[26]);\n    const yawDeg         = parseFloat(fields[27]);\n    const accelMag       = parseFloat(fields[28]);\n    const gyroMag        = parseFloat(fields[29]);\n    const imuTempC       = parseFloat(fields[30]);\n    const motion         = parseInt(fields[31]);\n    const accelX         = parseFloat(fields[32]);\n    const accelY         = parseFloat(fields[33]);\n    const accelZ         = parseFloat(fields[34]);\n\n    return [\n        stateNo,          //  1\n        stateName,        //  2\n        stateNameNum,     //  3\n        tempK,            //  4\n        tempC,            //  5\n        coolingRate,      //  6\n        dacTarget,        //  7\n        dacActual,        //  8\n        rmsV,             //  9\n        relayNormal,      // 10\n        alarmRelay,       // 11\n        redLed,           // 12\n        greenLed,         // 13\n        onDurationMs,     // 14\n        onDuration,       // 15\n        stateText,        // 16\n        cooldownPct,      // 17\n        timeInState,      // 18\n        ambientTempC,     // 19\n        currentA,         // 20\n        backoffCount,     // 21\n        tempBelowAmbient, // 22\n        rollDeg,          // 23\n        pitchDeg,         // 24\n        yawDeg,           // 25\n        accelMag,         // 26\n        gyroMag,          // 27\n        imuTempC,         // 28\n        motion,           // 29\n        accelX,           // 30\n        accelY,           // 31\n        accelZ            // 32\n    ];\n}\n",
    "frameStart": "/*",
