	)
	(text "R45 + R122 = 47k + 3.6k || 1 nF (gain 16.3, pole ~3 kHz) so full code gives about 10 Vpp, as on the signal_gen sheet. MMBZ9V1 clamp left out here."
		(exclude_from_sim no)
		(at 20 24.5 0)
		(effects
