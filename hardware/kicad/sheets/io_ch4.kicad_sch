	(text "Universal I/O channel 4: connector pin 1 = switched sensor supply, 2 = signal, 3 = GND. Output: DAC level x 4.83 from a TSB582 section through a switch (IO Output Drivers sheet), up to 100 mA, open while OUT_EN is low."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "469a30bb-5bf5-5c3e-a177-b053b6a2c0f7")
	)
	(text "BIAS"
		(exclude_from_sim no)
		(at 208.28 147.32 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "918542a8-27ae-52e0-bad3-25ce0ef00050")
	)
	(text "Input: the pin through 100k to the ADC; with the 20k leg grounded (default) 15 V reads 2.5 V, with DIRECT high the range is 0-2.5 V. BURDEN adds 120 R for 4-20 mA loops; PULLUP (range switch sheet) adds 10k to +3V3."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "945b240c-b38a-599a-b362-aec6ccab643d")
	)
	(text "Every control line is pulled to its off level, so the channel is high impedance with the sensor supply off until firmware sets the expander."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "a5039f0b-6650-509a-9f95-b1741389f2fb")
	)
	(text "SENSOR SUPPLY AND CONNECTOR"
		(exclude_from_sim no)
		(at 208.28 43.18 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "b701985b-8fdb-51aa-a3f5-b95e81a02b48")
	)
	(text "MEASUREMENT"
		(exclude_from_sim no)
		(at 25.4 132.08 0)
		(effects
