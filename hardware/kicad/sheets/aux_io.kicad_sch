				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "97c6e9f9-ed12-5ba1-bb19-70f68a4e1542")
	)
	(text "ESD CLAMPS (HEADER SIDE)"
		(exclude_from_sim no)
		(at 116.84 68.58 0)
