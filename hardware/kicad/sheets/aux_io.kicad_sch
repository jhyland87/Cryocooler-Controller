	(text "The op amps run from +5V_OR, so the LEDs also work on USB power. Their inputs are diode-clamped to that rail; the 100k from each pin limits the current."
		(exclude_from_sim no)
		(at 20 33 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "008d2c97-6400-5095-8d6f-3e0d454fe2bd")
	)
	(text "General-purpose I/O: GPIO5, 7, 11 and 13 each on a 2-pin header (signal, GND), 3.3 V only. 100 R in series, ESD clamp at the header, 200k to GND (the LED divider) so an open pin reads low."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "02e9a6ef-90bc-5d88-9dda-a14e60626360")
	)
	(text "SPARE SECTIONS (FOLLOWERS ON THE SUPPLY PIN BESIDE THEM)"
		(exclude_from_sim no)
		(at 248.92 137.16 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "1cdde8e2-b4a6-53b4-9e52-d790a64f7bd3")
	)
	(text "GPIO5 and GPIO7 are ADC1 (analog input works with WiFi on); GPIO11 and 13 are ADC2, digital only while WiFi runs. GPIO12 is CAN_RX since rev 5."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "52f3c7dd-878e-5b55-a52b-ea851f94c241")
	)
	(text "LED per pin: an OPA4990 section holds half the pin voltage across 3.3k with the green die in its feedback path: 0.5 mA at 3.3 V, proportional below that."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "65384a47-8934-5355-b08e-d4783846f4b5")
	)
	(text "OPA4990 DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 167.64 182.88 0)
		(effects
