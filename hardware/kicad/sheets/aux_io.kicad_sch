	(text "GPIO5 and GPIO7 are ADC1 (analog input works with WiFi on); GPIO11-13 are ADC2, digital only while WiFi runs."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "195a8522-f9b0-5944-bd20-5cf7dd39ecb3")
	)
	(text "General-purpose I/O: GPIO5, 7, 11, 12 and 13 each on a 2-pin header (signal, GND), 3.3 V only. 100 R in series, ESD clamp at the header, 200k to GND (the LED divider) so an open pin reads low."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "36eda40a-1c92-5ab9-956e-31509e502cbf")
	)
	(text "SPARE SECTIONS (FOLLOWERS ON THE SUPPLY PIN BESIDE THEM)"
		(exclude_from_sim no)
		(at 248.92 137.16 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "4f7a93fb-3cf0-5ab3-a9eb-99a0b1a2afaa")
	)
	(text "LED DRIVERS"
		(exclude_from_sim no)
		(at 167.64 55.88 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "7704fcd3-886c-5049-8009-46b5ef34f656")
	)
	(text "LED per pin: an OPA4990 section holds half the pin voltage across 3.3k with the green die in its feedback path: 0.5 mA at 3.3 V, proportional below that."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "a95f3f27-bfd4-567f-8850-0635e4fd93ef")
	)
	(text "OPA4990 DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 167.64 182.88 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "b5921650-17cb-587e-bb15-287d24271ff4")
	)
	(text "The op amps run from +5V_OR, so the LEDs also work on USB power. Their inputs are diode-clamped to that rail; the 100k from each pin limits the current."
		(exclude_from_sim no)
		(at 20 33 0)
		(effects
			(font
				(size 1.8 1.8)
