	(text "Two MCP23S17 share IO_EXP_CS: hardware addresses 0 and 1 on A0 (A2 low on both, so one write of IOCON.HAEN reaches every device: errata DS80311A). Port A serves the odd channel of a pair, port B the even one."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "148c7232-23ce-5abb-bd03-8a075c728889")
	)
	(text "7 BUF_OE_N (fast channels 1 and 2; the RS-485 and header interrupts on 3 and 4). All pins are inputs after reset, so the pull resistors on each line set the off state."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "36ea0bba-7011-5ade-a157-5e4c139988e1")
	)
	(text "ADDRESS 0"
		(exclude_from_sim no)
		(at 38.1 81.28 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "40d82c9a-9b2c-50be-bb7c-20186b524b50")
	)
	(text "ADDRESS 1"
		(exclude_from_sim no)
		(at 127 81.28 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "59f6a5a2-4e5a-515b-9141-1d2f734c7c50")
	)
	(text "INTA and INTB must be set open drain (IOCON.ODR) before interrupts are enabled: all four share IO_EXP_INT_N, pulled up at address 0."
		(exclude_from_sim no)
		(at 20 39 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "8d8c5227-3f6c-5e29-acda-70d0d8c11262")
	)
	(text "RESET on ESP_EN: an ESP32 reset also returns every channel to off."
		(exclude_from_sim no)
		(at 20 33 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "9c51ad4c-ec1c-5d46-a90e-aefd3297a878")
	)
	(text "Per port: bit 0 OUT_EN, 1 DIRECT (channel 1: on address 1 GPB5), 2 BURDEN, 3 PULLUP, 4 SENS_EN (outputs), 5 OUT_FLT_N (channel 1; elsewhere a spare), 6 SENS_FLT_N (inputs),"
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "e99d479a-3ff5-534b-8140-cb096514ed3b")
	)
	(text "MCP23S17 DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 127 185.42 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "fac6bf3e-7b0e-5734-ba0b-88e67fbdbe69")
	)
