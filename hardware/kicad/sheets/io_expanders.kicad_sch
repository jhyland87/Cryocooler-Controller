	(text "MCP23S17 DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 127 185.42 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "01929bb4-d433-589f-836c-e4086416ee68")
	)
	(text "ADDRESS 1"
		(exclude_from_sim no)
		(at 152.4 78.74 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "355f2f27-adaf-5b64-9382-b200e5bf629e")
	)
	(text "Per port: bit 0 OUT_EN, 1 DIRECT (channel 1: on address 1 GPB5), 2 BURDEN, 3 PULLUP, 4 SENS_EN (outputs), 5 OUT_FLT_N (channel 1; elsewhere a spare), 6 SENS_FLT_N (inputs), 7 BUF_OE_N (fast channels 1 and 2; the RS-485 and header interrupts on 3 and 4). All pins are inputs after reset, so the pull resistors on each line set the off state."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "4256fb93-5fae-547b-aee4-667e5cbd8c59")
	)
	(text "BIAS"
		(exclude_from_sim no)
		(at 25.4 177.8 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "692baccd-3121-5a4b-9403-51810e939352")
	)
	(text "ADDRESS 0"
		(exclude_from_sim no)
		(at 63.5 78.74 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "997bb37e-76a3-5ce9-94e7-149b652dd35d")
	)
	(text "RESET on ESP_EN: an ESP32 reset also returns every channel to off. INTA and INTB must be set open drain (IOCON.ODR) before interrupts are enabled: all four share IO_EXP_INT_N."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "c73f178b-b2ec-5968-8dd6-a12abd4692ef")
	)
	(text "Two MCP23S17 share IO_EXP_CS: hardware addresses 0 and 1 on A0 (A2 low on both, so one write of IOCON.HAEN reaches every device: errata DS80311A). Port A serves the odd channel of a pair, port B the even one."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "d406cdb9-bea0-5b2f-b3c2-6ce4a63c7910")
	)
