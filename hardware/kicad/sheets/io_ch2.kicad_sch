							)
						)
					)
				)
			)
			(embedded_fonts no)
		)
	)
	(text "Input: the pin through 100k to the ADC; with the 20k leg grounded (default) 15 V reads 2.5 V, with DIRECT high the range is 0-2.5 V. BURDEN adds 120 R for 4-20 mA loops; PULLUP (range switch sheet) adds 10k to +3V3."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "14fe5784-c183-5e80-81b8-56330934423b")
	)
	(text "SENSOR SUPPLY AND CONNECTOR"
		(exclude_from_sim no)
		(at 208.28 43.18 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "363ff764-7165-5517-9865-a722431049ed")
	)
	(text "GATE AND BUFFER DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 208.28 213.36 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "58812bb5-8bed-516f-9ccf-09de88847c39")
	)
	(text "Every control line is pulled to its off level, so the channel is high impedance with the sensor supply off until firmware sets the expander. GPIO7 gates the DAC level (PWM) and reads the pin through the buffer."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "6e0cd839-1e1f-5762-bef3-e975f6ea8c37")
	)
	(text "Universal I/O channel 2: connector pin 1 = switched sensor supply, 2 = signal, 3 = GND. Output: DAC level x 4.83 from a TSB582 section through a switch (IO Output Drivers sheet), up to 100 mA, open while OUT_EN is low."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "80a3669b-bbe2-5ea2-8690-f273283cee70")
	)
	(text "OUTPUT GATE (GPIO7)"
		(exclude_from_sim no)
		(at 25.4 50.8 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "8b4387d8-9ba3-5e15-ae11-a993e09a6f2d")
	)
	(text "FAST PATH (GPIO7)"
		(exclude_from_sim no)
		(at 50.8 193.04 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "f122be65-28e6-5884-a530-85632d38e060")
	)
