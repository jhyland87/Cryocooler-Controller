						)
					)
				)
			)
			(embedded_fonts no)
		)
	)
	(text "Universal I/O channel 1: connector pin 1 = switched sensor supply, 2 = signal, 3 = GND. Output: DAC level x 4.83 from a TSB582 section through a switch (IO Output Drivers sheet), up to 100 mA, open while OUT_EN is low."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "0da45cc6-3407-542d-a617-33548fb9bbed")
	)
	(text "OUTPUT GATE (GPIO5)"
		(exclude_from_sim no)
		(at 25.4 50.8 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "1f1f604f-a173-5522-8cf7-4dde5bf3e640")
	)
	(text "MEASUREMENT"
		(exclude_from_sim no)
		(at 25.4 132.08 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "2ce2439c-84b5-52a7-b938-ccaea9758098")
	)
	(text "SENSOR SUPPLY AND CONNECTOR"
		(exclude_from_sim no)
		(at 208.28 43.18 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "485a515e-ea3b-5064-b366-d4c3d4275037")
	)
	(text "Input: the pin through 100k to the ADC; with the 20k leg grounded (default) 15 V reads 2.5 V, with DIRECT high the range is 0-2.5 V. BURDEN adds 120 R for 4-20 mA loops; PULLUP (range switch sheet) adds 10k to +3V3."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "56c1e0fc-55d6-59ef-a32f-92613e3a428e")
	)
	(text "FAST PATH (GPIO5)"
		(exclude_from_sim no)
		(at 25.4 190.5 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "5c51bce4-18c3-5dae-91d7-df026e622c78")
	)
	(text "Every control line is pulled to its off level, so the channel is high impedance with the sensor supply off until firmware sets the expander. GPIO5 gates the DAC level (PWM) and reads the pin through the buffer."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "71132fe6-4a96-59c1-9d13-2d334e268de9")
	)
	(text "BIAS"
		(exclude_from_sim no)
		(at 208.28 147.32 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "83625624-f993-5b79-8f86-ec58c5028be5")
	)
	(text "GATE AND BUFFER DECOUPLING CAPACITORS"
