	)
	(text "The ADC reads each signal against REFP0 / REFN0, which is that same excitation, so the reading does not move with the 5 V rail. PGA bypassed. With nothing plugged in the 100k pull-down gives 0 V, below the 0.5 V a working sensor sends."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "7e780b58-7f9e-50ca-a51c-42cea3674176")
	)
	(text "Two ports for 3-wire pressure transmitters with a 0.5-4.5 V output on a 5 V supply (port 1: 100 psi ahead of the nitrogen membrane, port 2: 30 psi in the dewar). Pin 1 is the switched 5 V excitation shared with the precision ports."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "884ef626-4a8c-57f2-a1c6-6f214bc0b21c")
	)
