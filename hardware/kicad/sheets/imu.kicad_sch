	(text "Module Vin = +3V3 keeps its logic at 3.3 V. NUF6401MN filter: 100 R in series to damp the cable, 17 pF and an ESD clamp on each side of all six signals."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "7fe47a0c-d118-51e2-9145-779242aa2a52")
	)
	(text "LSM6DSOX is the off-board Adafruit module (product 4438) on the cooler, cabled to J14 (Molex Micro-Lock Plus 2x4, 1.25 mm) over the main SPI bus (CS from the decoder, INT1 GPIO2 single-tap, INT2 GPIO39 wake-up)."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "a086da08-c33b-5e4f-b8da-ad45f5fbeca8")
	)
	(text "J14 pin -> module pad: 1 SCL, 2 GND, 3 SDA, 4 Vin, 5 CS, 6 DO, 7 I1, 8 I2 (3Vo pad open). Keep the cable short and twist SCK with GND (pins 1-2 sit one above the other)."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "ecd15b31-7dac-54ff-9ea1-a2c9c61c483e")
	)
