		(uuid "6aba786c-c0e1-5095-92d4-c69c1639a46d")
	)
	(text "The datasheet does not say MISO is high-impedance with CS high, so a 74LVC1G125 (OE# = CS) gates it onto SPI_MISO."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "8806225e-5931-50f3-885e-a9af3b2ad226")
	)
	(text "SC18IS604 DECOUPLING CAPACITORS"
