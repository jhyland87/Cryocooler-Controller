	(text "SC18IS604: SPI mode 3 slave on the main bus (CS GPIO8, RESET GPIO9), I2C controller at ~100 kHz for the EMC2303 (0x4D). INT# is polled through the I2CStat register and only has a pull-up and a test point."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "0dad3b6a-af00-53b9-876a-6a3a549fed1c")
	)
	(text "The datasheet does not say MISO is high-impedance with CS high, so a 74LVC1G125 (OE# = CS) gates it onto SPI_MISO."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "35e3f79f-a48d-50ca-905e-520ca9ac9fce")
	)
	(text "SC18IS604 DECOUPLING CAPACITORS"
