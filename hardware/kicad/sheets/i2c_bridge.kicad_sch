	)
	(text "SC18IS604: SPI mode 3 slave on the main bus (CS GPIO8, RESET GPIO9), I2C controller at ~100 kHz for the EMC2303 (0x4D). INT# is polled through the I2CStat register and only has a pull-up and a test point."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "6cec65df-bbe2-5820-b4e9-f1087d444856")
	)
