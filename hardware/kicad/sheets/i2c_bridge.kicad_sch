	(text "The datasheet does not say MISO is high-impedance with CS high, so a 74LVC1G125 (OE# = CS) gates it onto SPI_MISO."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "51573b0a-9c5d-5f1d-9ca2-0f072e34384e")
	)
	(text "SC18IS604: SPI mode 3 slave on the main bus (CS GPIO8, RESET GPIO9), I2C controller at ~100 kHz for the EMC2303 (0x4D). INT# is polled through the I2CStat register and only has a pull-up and a test point. GPIO0 enables the display backlight; GPIO1-4 read the four +/-15 V power-good flags."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "8595ed01-cbd2-5d0c-aa3c-80d589dee7c5")
	)
