	(text "Q1 gate: 10k series and 47 nF to the drain limit the ramp to about 20 V/ms; 470 nF to the source holds Vgs under 1.1 V on a hot plug (10 x Cgd); the Zener caps Vgs at 15 V for input transients up to the 26 V TVS clamp."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "05442d62-9196-5aae-8332-3a9810c2a925")
	)
	(text "Fit the jumper to switch on as soon as 12 V arrives. PB then stays low for roughly 80-500 ms (2.2 uF on the 100k pull-up to 1.9 V), longer than the 32 ms turn-on debounce. Holding the button still forces power off."
		(exclude_from_sim no)
		(at 25.4 182.88 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "412c6fe2-b05d-5fb8-8f8a-49281d2115a9")
	)
	(text "LTC2954 DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 215.9 40.64 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "652dcc89-d54e-51f6-acf3-e95d3c69552d")
	)
	(text "PUSH-BUTTON CONTROLLER"
		(exclude_from_sim no)
		(at 25.4 38.1 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "6f62ca3c-92dc-5768-9bb5-90337d4ba749")
	)
	(text "AUTO POWER-ON (OPTIONAL, NOT BENCH TESTED)"
		(exclude_from_sim no)
		(at 25.4 177.8 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "72cb83d5-be45-5c1b-8590-70ab9dbcd4e2")
	)
	(text "12 V LOAD SWITCH"
		(exclude_from_sim no)
		(at 177.8 68.58 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "ad0c8390-6fad-5ff4-959e-5b213625dec7")
	)
	(text "Assumed, not verified: the LTC2954 accepts PB low from power-up as a turn-on (its datasheet describes a high-to-low transition). Try it on a rev 4 board with a capacitor across SW3 first."
		(exclude_from_sim no)
		(at 25.4 186.69 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "b6214dda-bf45-5a40-ae55-35e84e3d0866")
	)
	(text "LTC2954-2: tap PB = on, hold = off. EN# drives the P-FET gate; KILL# from GPIO10 (active low, 100 ms pulse). INT# tells GPIO1 to shut down cleanly; holding PB cuts power about 6.4 s later (1 uF on PDT)."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "f76cd1c2-93d7-5070-9881-e138bc5119c9")
	)
	(text "STATUS LED: red = standby (about 0.8 mA from VIN, off when +3V3 is up), green = on (+5V, about 1 mA), both = +3V3 missing"
		(exclude_from_sim no)
		(at 25.4 116.84 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "fff2ad46-5c78-53a4-8a5c-323fed03d498")
	)
