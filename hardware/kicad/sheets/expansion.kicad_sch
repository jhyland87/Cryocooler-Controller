			)
			(justify left top)
		)
		(uuid "22808ade-fde3-5c76-b74e-f9cbf591e523")
	)
	(text "AUX HEADER: GPIO11 AND GPIO13"
		(exclude_from_sim no)
		(at 177.8 157.48 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "28223bec-888d-5dba-bd4a-ff978d4c4e23")
	)
	(text "SPI expansion header: 1 +3V3, 2 +5V, 3 SCK, 4 MOSI, 5 MISO, 6 INT (active low, to the I/O expander), 7 CS A, 8 CS B, 9 and 10 GND. MISO reaches the bus only while a chip select is low."
		(exclude_from_sim no)
		(at 20 33 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "2e8b5857-a5f6-5c0a-84d8-d86c34ba0dd0")
	)
	(text "SC16IS750 AND CLOCK DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 38.1 238.76 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "43540768-e5e0-570e-b49e-40a44633fbbd")
	)
	(text "AUX header: 1 +5V, 2 +3V3, 3 GPIO11, 4 GPIO13, 5 GND. Both pins are touch (T11, T13) and ADC2 inputs; ADC2 is not usable while WiFi is on."
		(exclude_from_sim no)
		(at 20 39 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "48fcbbe5-fe0e-5101-99fb-37965dd96243")
	)
	(text "RS-485: SC16IS750 (SPI mode 0 only, 4 MHz max) with the same 16 MHz oscillator as the signal generator: 9600, 19200 and 38400 baud are 0.16 % off; 57600 (2.1 %) and 115200 (3.5 %) are not usable. Direction: EFCR.RTSCON = 1, RTSINVER = 0."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "515fa556-171d-5eaf-9a56-a778a40b6f17")
	)
	(text "MISO BUFFER DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 177.8 238.76 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "8becec74-eb50-59a1-8e5f-7895622e138a")
	)
	(text "SPI EXPANSION HEADER"
		(exclude_from_sim no)
		(at 248.92 50.8 0)
		(effects
