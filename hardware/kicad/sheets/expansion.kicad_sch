	)
	(text "RTS goes low while sending, and the FET turns that into DE high. After reset RTS is high, so the driver is off. CTS and the bridge GPIOs are unused."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "bbbf4419-6426-5905-8cea-82afcc59fc46")
	)
	(text "RS-485: SC16IS750 (SPI mode 0 only, 4 MHz max) with the same 16 MHz oscillator as the signal generator: 9600, 19200 and 38400 baud are 0.16 % off; 57600 (2.1 %) and 115200 (3.5 %) are not usable. Direction: EFCR.RTSCON = 1, RTSINVER = 0."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "d203ae17-5bb7-5f1d-b97b-09fc81435804")
	)
	(text "SPI expansion header: 1 +3V3, 2 +5V, 3 SCK, 4 MOSI, 5 MISO, 6 INT (active low, to the I/O expander), 7 CS A, 8 CS B, 9 and 10 GND. MISO reaches the bus only while a chip select is low."
		(exclude_from_sim no)
		(at 20 33 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "f420da67-919b-5a5a-b49a-9f4c6b61df1e")
	)
	(text "THVD2410: fail-safe receiver, +-70 V bus fault, +-12 kV IEC ESD, so no bias resistors and no extra clamp. Fit the jumper to end the bus with 120 R here."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "fbbe240a-ae34-5057-9239-a7e6d95801ff")
	)
