			)
			(justify left top)
		)
		(uuid "956933e1-fe4e-573b-81f3-5e8f86696a98")
	)
	(text "RS-485 / MODBUS PORT"
		(exclude_from_sim no)
		(at 25.4 50.8 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "bc99b9d8-ca6f-59b0-8100-d39aaa75da05")
	)
	(text "UART, I2C, 1-Wire, touch or GPIO"
		(exclude_from_sim no)
		(at 177.8 162.56 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "c2a98d29-c417-5530-ba1d-f8bbe90e68cc")
	)
	(text "100 R IN SERIES WITH EVERY LINE THE BOARD DRIVES"
		(exclude_from_sim no)
		(at 248.92 149.86 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "d8b49f7a-24c2-546e-bb87-c36f930117e4")
	)
	(text "RTS goes low while sending, and the FET turns that into DE high. After reset RTS is high, so the driver is off. CTS and the bridge GPIOs are unused."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "dc68370e-f808-5925-bbca-feb8ef45d3bb")
	)
	(text "UART CLOCK"
		(exclude_from_sim no)
		(at 25.4 177.8 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "ea12f083-c0b3-504b-9b54-cc04370550b5")
	)
	(text "THVD2410: fail-safe receiver, +-70 V bus fault, +-12 kV IEC ESD, so no bias resistors and no extra clamp. Fit the jumper to end the bus with 120 R here."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "ee8a1e40-22cb-56a7-a109-23996765da06")
	)
