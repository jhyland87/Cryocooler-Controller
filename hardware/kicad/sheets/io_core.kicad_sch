	(text "DAC60508 DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 38.1 180.34 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "07647d63-99ca-56a1-9274-83dc8dab3021")
	)
	(text "OUTPUT LEVEL DAC"
		(exclude_from_sim no)
		(at 25.4 55.88 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "3d2e7418-c02a-51f4-af4c-b376589fdc7c")
	)
	(text "Both release their data output when CS is high (DAC60508 section 8.5, ADS124S08 section 9.5.1), so they share SPI_MISO without a buffer."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "7ad1340e-61ee-585f-9023-df1c22687c13")
	)
	(text "DAC60508Z: 12-bit, outputs at zero after reset. On 3.3 V its 2.5 V reference needs the divider on with gain 2 (GAIN register), giving 0-2.5 V; until firmware writes that, the reference alarm holds every output at 0 V. SDI is latched on falling SCLK edges (SPI mode 1)."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "abc39c97-db04-5869-8a21-92101e0d4338")
	)
	(text "ADS124S08 AVDD DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 99.06 180.34 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "d230aee1-1707-5d3e-91c5-82685db144a0")
	)
	(text "ADS124S08: SPI mode 1, AVDD 5 V, logic 3.3 V. AIN0-3 read channels 1-4 against AINCOM = ground with the internal 2.5 V reference and the PGA bypassed (a ground-referenced input is outside the PGA range). AIN4 / AIN5 read the pressure ports against REFP0 / REFN0 (the 5 V excitation). AIN8-11 serve the precision ports. START and CLK low. DAC outputs 4-7 and AIN6 / AIN7 are not used."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "d5948eb4-a76f-5b85-8d2a-adfd5302847c")
	)
	(text "ADS124S08 DVDD / IOVDD DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 170.18 180.34 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "e3979af4-963d-5bb6-9c3d-e8ab7e492633")
	)
	(text "INPUT ADC"
		(exclude_from_sim no)
		(at 190.5 55.88 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "e6dc825c-7c78-5d0f-a762-afd2710b5047")
	)
