	(text "Mains-class creepage/clearance applies between ISO_GND domain and the logic side on the PCB. No F suffix: the isolated outputs go high (CS inactive, SCK idle) if the logic side loses power."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "b812c7c4-7975-532b-9b44-47881b10a6bd")
	)
	(text "The ACS37800 and the isolator drive MISO all the time, so MISO reaches the shared bus only while ~{ACS_CS} is low. SCK is gated the same way, so bus traffic for other devices never clocks the ACS37800."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "ba1d08ea-24b5-55fe-8524-f70b0ed3a50a")
	)
