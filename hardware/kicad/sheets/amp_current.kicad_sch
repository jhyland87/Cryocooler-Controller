	(text "The ACS37800 and the isolator drive MISO all the time, so MISO reaches the shared bus only while ACS_CS is low."
		(exclude_from_sim no)
		(at 241.3 106.68 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "08d23bc9-d689-5a7d-a9cf-4ba9b81174f4")
	)
	(text "ISOW7841 VCC DECOUPLING"
		(exclude_from_sim no)
		(at 25.4 154.94 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
