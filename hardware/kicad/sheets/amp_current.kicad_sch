	)
	(text "Amplifier output V/I monitor: ACS37800 (SPI, 15 mA max) on an isolated 5 V domain from the ISOW7841A (SEL on VISO selects 5 V). It runs from +3V3_ISO because its one supply pin also sets the logic thresholds; 3.3 V in gives 40 mA at 5 V out."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "0fb572c3-0b8f-5eb3-8415-6e6a04665be7")
	)
