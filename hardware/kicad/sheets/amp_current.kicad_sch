	)
	(text "ACS37800 and ISOW7741 drive MISO all the time, so MISO reaches the shared bus only while ACS_CS is low."
		(exclude_from_sim no)
		(at 241.3 106.68 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "106a7514-d2f7-50b9-85f2-ce6b77261f49")
	)
	(text "ISOW7741 VISOOUT DECOUPLING"
		(exclude_from_sim no)
		(at 134.62 154.94 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "1c513f67-abea-568d-b334-e047ef12f490")
	)
	(text "Amplifier output V/I monitor: ACS37800 (SPI) on an isolated 5 V domain from the ISOW7741 (110 mA max at 5 V to 5 V; VSEL on VISOOUT selects 5 V). Beads on VISOOUT-VISOIN and GND2-GISOIN follow the ISOW774x datasheet for emissions."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "22ee61c7-0b18-5284-9d15-44f520f5c8dc")
	)
	(text "ISOW7741 VIO DECOUPLING"
		(exclude_from_sim no)
		(at 25.4 154.94 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "390b71e0-7d27-54dc-bd98-deb3cf26db27")
	)
	(text "ACS37800 DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 25.4 185.42 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "3d1de95d-3165-5fa7-9ac4-6a2193d68639")
	)
	(text "ISOW7741 VDD DECOUPLING"
		(exclude_from_sim no)
		(at 73.66 154.94 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "610ac429-f1cf-56c0-8012-d5887e043f22")
	)
	(text "SN74LVC1G125 DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 241.3 208.28 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "65053eb9-a508-5fd1-880a-0625b306750e")
	)
	(text "SCK is gated the same way, so bus traffic for other devices never clocks the ACS37800. 10k pull-ups hold both gates closed at reset."
		(exclude_from_sim no)
		(at 241.3 110.49 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "6f34abbb-066f-5527-9190-f182a00ea6e3")
	)
	(text "ACS37800 SPI GATES (LOGIC SIDE)"
		(exclude_from_sim no)
		(at 241.3 101.6 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "75069a3c-b0d4-54b0-9e4d-999c18b904bf")
	)
	(text "Mains-class creepage/clearance applies between ISO_GND domain and the logic side on the PCB. EN/FLT is an open-drain fault flag as well as the enable, so it has a pull-up rather than a tie to VIO."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "8d6594b6-a4c1-5a42-9656-8fb8a3343ef8")
	)
