	(text "Amplifier output V/I monitor: ACS37800 (SPI, 15 mA max) on an isolated 5 V domain from the ISOW7841A (SEL on VISO selects 5 V). It runs from +3V3_ISO because its one supply pin also sets the logic thresholds; 3.3 V in gives 40 mA at 5 V out."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "18ad2f33-8e4d-5294-86a4-14099684ef60")
	)
	(text "SCK is gated the same way, so bus traffic for other devices never clocks the ACS37800. ACS_CS comes from the CS decoder, which holds it high at reset."
		(exclude_from_sim no)
		(at 241.3 110.49 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "500f2b39-aa28-50d5-98e0-e6d1c1e138a0")
	)
	(text "The ACS37800 and the isolator drive MISO all the time, so MISO reaches the shared bus only while ACS_CS is low."
		(exclude_from_sim no)
		(at 241.3 106.68 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "5b3d038a-6707-5e5d-b056-2b23d584b752")
	)
	(text "ISOW7841 VCC DECOUPLING"
		(exclude_from_sim no)
		(at 25.4 154.94 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "5f9491b5-b4cf-568c-8e22-7b01ba6cdaf8")
	)
	(text "ACS37800 DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 25.4 185.42 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "61649660-d1b2-571b-9d54-b66adeb92b81")
	)
	(text "ISOW7841 VISO DECOUPLING"
		(exclude_from_sim no)
		(at 73.66 154.94 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "67508182-1947-52cb-a410-2d539ac114da")
	)
	(text "ACS37800 SPI GATES (LOGIC SIDE)"
		(exclude_from_sim no)
		(at 241.3 101.6 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "8ca910ed-1abf-5c38-a104-ae09525f0d59")
	)
	(text "SN74LVC1G125 DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 241.3 208.28 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "99a9f92a-1029-5f32-80a3-f43f2fe3efb8")
	)
	(text "Mains-class creepage/clearance applies between ISO_GND domain and the logic side on the PCB. No F suffix: the isolated outputs go high (CS inactive, SCK idle) if the logic side loses power."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "f05bb099-d7ce-5565-a876-063433c693c9")
	)
