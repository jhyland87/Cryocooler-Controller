		(uuid "646d79ee-7f05-5c3c-9258-e7a116463d8e")
	)
	(text "ACS37800 DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 25.4 185.42 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "7d25e1c4-7584-5de4-ade3-5081f3cadfcc")
	)
	(text "SCK is gated the same way, so bus traffic for other devices never clocks the ACS37800. ACS_CS comes from the CS decoder, which holds it high at reset."
		(exclude_from_sim no)
		(at 241.3 110.49 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "88e92606-0655-5cc0-a5b1-3c21e95a26b2")
	)
