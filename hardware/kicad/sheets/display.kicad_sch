	(text "ESP32-S3-Touch-LCD-4.3B"
		(exclude_from_sim no)
		(at 321 99 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "082aa519-bc0a-5c15-9933-5e634ad302b1")
	)
	(text "Waveshare ESP32-S3-Touch-LCD-4.3B (own ESP32-S3, 800 x 480, 7-36 V in, about 2.3 W): telemetry and commands over CAN (its TJA1051T/3 on GPIO15 / GPIO16, 120 R by switch)."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "0cdb0923-dc94-5f38-9140-3744609e0769")
	)
	(text "OFF-BOARD: WAVESHARE TOUCHSCREEN WITH ITS OWN ESP32-S3"
		(exclude_from_sim no)
		(at 300 70 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "15682dbe-8c25-53b6-a80d-c79f66632605")
	)
	(text "J21 (Power Button sheet): DO0 = power button, DO1 = reset, GND"
		(exclude_from_sim no)
		(at 300 149 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "43a51ad6-f00a-5d41-895b-efb88c853eef")
	)
	(text "It is fed from VIN, ahead of the power switch, so it runs while this board is off. 120 R ends the bus at this board."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "472c75ff-b1b7-5406-b57b-ffdfa8b777fa")
	)
	(text "WAVESHARE"
		(exclude_from_sim no)
		(at 324 91 0)
		(effects
			(font
				(size 3.0 3.0)
			)
			(justify left top)
		)
		(uuid "582ac72f-9995-5889-b762-a476a4ca465e")
	)
	(text "J15: VIN (12 V), GND, CAN H, CAN L terminals"
		(exclude_from_sim no)
		(at 300 145 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "68f15fde-0647-5bfb-b94f-561f4085922d")
	)
	(text "runs its own firmware"
		(exclude_from_sim no)
		(at 328 110 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "895e35b2-0be6-5b33-85d6-ff8592575bcf")
	)
	(text "CAN TRANSCEIVER"
