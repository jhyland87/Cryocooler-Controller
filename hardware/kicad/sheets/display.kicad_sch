			)
			(justify left top)
		)
		(uuid "89e91864-f271-59f3-8d26-ded1f72069ac")
	)
	(text "TCAN3414 (SLLSFS8A): 3.3 V supply, STB and SHDN low = normal mode, TXD dominant time-out 1.2 ms min, bus pins high impedance when unpowered, +-58 V bus fault protection."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
