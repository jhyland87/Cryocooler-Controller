	(text "EXCITATION (BOTH PORTS)"
		(exclude_from_sim no)
		(at 25.4 55.88 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "2b5e9522-feb0-57ea-8dae-e53d84dda5f9")
	)
	(text "Two ports for sensors the universal channels suit badly: bridges (load cells, bare pressure sensors), RTDs, thermocouples, millivolt cells. Each has a differential pair straight into the ADS124S08 (port A: AIN8 / AIN9, port B: AIN10 / AIN11)."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "96ed1530-facd-59ab-b97d-d3408701c909")
	)
	(text "Inputs must stay between 0 V and 5 V. 2.2 k limits the current into the ADC to 3 mA with 12 V on a pin (10 mA allowed), so a wiring mistake does no damage; the reading of every ADC input is disturbed while it lasts. Excitation is off until PREC_EXC_EN is high."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "a7bd596d-1118-5a72-a9cb-e34820fd5b85")
	)
	(text "BIAS"
		(exclude_from_sim no)
		(at 299.72 55.88 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "be9f2bb0-6f2e-5715-aaa8-af824b8a5553")
	)
	(text "PRECISION PORT A"
		(exclude_from_sim no)
		(at 25.4 127 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "db2c9411-fb80-579d-a7b6-ba4ff7ccf08c")
	)
	(text "EXCITATION AS THE ADC REFERENCE"
		(exclude_from_sim no)
		(at 190.5 55.88 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "dd7e4c18-a0b1-5769-b716-1c5cd213bcd0")
	)
	(text "Gain, the 10 uA-2 mA current sources, the thermocouple bias and burn-out detection are ADC register settings. The 5 V excitation also feeds REFP0 / REFN0, so a bridge read against that reference ignores drift in the 5 V rail."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "f7983b44-7f0c-58b0-b8b1-e07a4003fe61")
	)
	(text "PRECISION PORT B"
		(exclude_from_sim no)
		(at 25.4 195.58 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "f8161e6e-8e54-5a34-8ce4-c87510191df1")
	)
