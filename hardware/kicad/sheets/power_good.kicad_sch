	(text "LT8582 POWER GOOD (to MCP23S08 GP2 / GP3)"
		(exclude_from_sim no)
		(at 25.4 177.8 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "3d774d4d-7d74-5586-8667-401bf0881ea7")
	)
	(text "PG_15V = the two nodes ANDed by a BAT54AW with a 470k pull-up to +3V3 (weak so it cannot lift dead nodes; 3.3 V only when both are good); it gates the amplifier REM switch and reads LOW on GPIO43 (PG_15V_N) when both rails are good."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "86843dc4-1c4a-5abf-b83a-1f6a9cbfd57e")
	)
	(text "PGP and PGN pull their own node low when bad. Each node is the +15 V rail through 220k/62k (about 3.2 V when good, under 0.3 V if its pin pulls low or the rail is missing) and lights its green LED."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "b3d83161-1b4d-58cc-b5fe-bf3e000ca419")
	)
