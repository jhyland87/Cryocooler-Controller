	(text "PG_15V = the two nodes ANDed by a BAT54AW with a 10k pull-up to +3V3 (3.3 V only when both are good); it gates the amplifier REM switch and reads LOW on GPIO43 (PG_15V_N) when both rails are good."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "a6c5867a-aeca-56df-a102-bfa0f0d32072")
	)
	(text "PGP and PGN pull their own node low when bad. Each node is the +15 V rail through 220k/62k (about 3.2 V when good, 0 V if its pin pulls low or the rail is missing) and lights its green LED."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "af6b5715-dfbb-50ea-8b24-a064ed4b034c")
	)
	(text "LT8582 POWER GOOD (to SC18IS604 GPIO3 / GPIO4)"
		(exclude_from_sim no)
		(at 25.4 177.8 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "cd8b6ad7-d26d-5664-be41-aadb8c971c02")
	)
