	(text "PG_15V = the two nodes ANDed by a BAT54AW with a 470k pull-up to +3V3 (weak so it cannot lift dead nodes; 3.3 V only when both are good); it gates the amplifier REM switch and reads LOW on GPIO43 (~{PG_15V}) when both rails are good."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "07224a97-3108-5620-8803-6dd7a51ded35")
	)
	(text "-15 V GUARD: an unpowered LT3094 cannot pull PGN low."
		(exclude_from_sim no)
		(at 17.78 124.46 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "374fd17d-a0ae-51a5-9e02-5a69fe162e4d")
	)
	(text "Midpoint near 0 V with both rails up, about +7.5 V with -15 V missing."
		(exclude_from_sim no)
		(at 17.78 129.54 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "4b77265d-0efa-5e1f-a53a-1cbab3c6ffa6")
	)
	(text "+15 V GOOD: NODE AND LED"
		(exclude_from_sim no)
		(at 55.88 152.4 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "4cad6f11-9ff3-55e8-8890-972350a21031")
	)
	(text "PGP and PGN pull their own node low when bad. Each node is the +15 V rail through 220k/62k (about 3.2 V when good, under 0.3 V if its pin pulls low or the rail is missing) and lights its LED green, or red when low."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "53c9d610-f4ae-530f-9360-0756c839e61e")
	)
