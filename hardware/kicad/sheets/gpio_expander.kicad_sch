	(text "MCP23S08: SPI mode 0 slave on the main bus (CS from the decoder). SO releases within 100 ns of CS rising (datasheet Fig. 2-6, parameter 14), so it shares SPI_MISO without a buffer. A1/A0 low: opcodes 0x40 / 0x41."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "a464b338-603c-5a6a-b043-3d6a02578eff")
	)
	(text "All pins power up as inputs. RESET, A1 and A0 must be biased (datasheet Table 1-1). Exposed pad to VSS, in addition to pin 17. GP7 is unused: firmware enables its weak pull-up."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "d8f8ee50-3ddb-5415-977a-0ae2cdc970cb")
	)
