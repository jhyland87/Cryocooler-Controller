		(uuid "9f872ba7-1fca-53b2-9501-615293a207b5")
	)
	(text "INT and CT are open drain and need 10 k pull-ups; they go to expander GP2 and GP3. Place this part far from anything that warms the board."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "3198933a-2f3d-509d-9983-6506a50a4ce9")
	)
	(text "BIAS"
		(exclude_from_sim no)
		(at 25.4 149.86 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "3cb7f08b-b2f6-5634-a5ed-23c6bcd5099d")
	)
	(text "ADT7320: SPI mode 3 (SCLK idles high), MSB first, on the main bus (CS from the decoder). DOUT is released within 80 ns of CS rising (datasheet Table 2, t7), so it shares SPI_MISO without a buffer. Pins 5-8 and 13-16 are not bonded: left open. Exposed pad to GND."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "47a1a3e5-f9fc-5f34-aac1-2a3b8e80065d")
	)
	(text "ADT7320 DECOUPLING CAPACITOR"
