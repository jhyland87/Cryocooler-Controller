	(text "VREF and RFB are limited to +/-12 V but the op-amps run from +/-14.7 V, so R50 and a 9.1 V bidirectional clamp protect VREF (under 10.5 V; 56 mW in R50). About 10 Vpp at full code; ZE500.1 RCA input range 0.2-6 V."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "1956b39c-e8d1-5b5a-bfef-057e2560f830")
	)
