	(text "OPA2991 -15V DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 215.9 129.54 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "117eac03-58b3-56a0-8ef1-4ba1082ff519")
	)
	(text "AD5453 DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 284.48 129.54 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "2bd2c7b5-f8eb-5ce3-955c-12f637e5babb")
	)
	(text "AD9837 (16 MHz clock) 60 Hz sine -> U5A gain stage -> AD5453 VREF. The 14-bit MDAC sets the amplitude: VOUT = -VREF x code / 16384. U5B is its output stage. Zero scale at power-on."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "4f73d6a8-dc35-541e-abdc-763812aee69a")
	)
	(text "ECS-2520MV DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 25.4 129.54 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "563b255b-e24e-5749-84b5-be810be02700")
	)
	(text "VREF and RFB are limited to +/-12 V but the op-amps run from +/-14.7 V, so R50 and a 9.1 V bidirectional clamp protect VREF (under 10.5 V; 56 mW in R50). About 10 Vpp at full code; ZE500.1 RCA input range 0.2-6 V."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "74be783d-fcab-54d4-9748-83c782a4ba0a")
	)
	(text "OPA2991 +15V DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 147.32 129.54 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "8063329c-3858-5f1c-a669-c41965a933f4")
	)
