			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
				(justify right)
			)
		)
	)
	(hierarchical_label "IO_OUT_FLT_A_N"
		(shape bidirectional)
		(at 91.44 243.84 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "fe4b67fe-b52e-5c1d-b713-c65bea175609")
		(property "Description" "Output switch fault flag of channels 1-4 (group A): low while a pin is forced past the rails, open drain, to the expander"
			(at 91.44 243.84 0)
			(hide yes)
			(show_name no)
			(do_not_autoplace no)
			(effects
				(font
					(size 1.27 1.27)
				)
				(justify left)
			)
		)
	)
	(text "CHANNELS 1-4"
		(exclude_from_sim no)
		(at 25.4 55.88 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "079b25cc-17cf-5e2d-8cc2-3fe3cad0e7d2")
	)
	(text "Open, the switch leaves only leakage on the pin. It also opens by itself when the pin is forced above +12V or below ground (FF goes low), so an outside source cannot feed the 12 V rail. Up to 100 mA per output: the switch rating (the op amp gives 150 mA min)."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "17d4c9af-8aa7-5662-a34c-d8a3adc3576d")
	)
	(text "Output drivers: each TSB582 section multiplies its channel level by 1 + 191k / 49.9k = 4.83 (0-12 V from +12V). A TMUX7412F section joins it to the pin while OUT_EN is high. Feedback is taken ahead of the switch."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "2d25f2c5-259c-5793-bb4f-25dd6c896f40")
	)
	(text "BIAS"
		(exclude_from_sim no)
		(at 25.4 236.22 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "5699a2b8-a3ac-5303-afd8-d55703eb26af")
	)
	(text "OUTPUT SWITCH DECOUPLING"
		(exclude_from_sim no)
		(at 327.66 193.04 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "b1c0953f-15c3-59ba-a497-da50341a652d")
	)
	(text "At 100 mA the pin sits about 1.5 V under the rail (0.55 V typ in the op amp, about 1 V in the 8-11 ohm switch). The ADC reads every pin, so firmware can check it. Channels 1 and 2 take their level from the GPIO gate on their own sheet."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "e90449b4-49eb-5ee8-82d0-bef33b3713a6")
	)
	(text "TSB582 DECOUPLING"
		(exclude_from_sim no)
		(at 106.68 251.46 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "ef2ba55a-cbb9-5749-a4a4-0119428d3690")
	)
