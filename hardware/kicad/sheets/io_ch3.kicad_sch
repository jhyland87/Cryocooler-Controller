	(text "MEASUREMENT"
		(exclude_from_sim no)
		(at 25.4 132.08 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "61f483b5-42dd-5011-b971-b11783846f8b")
	)
	(text "Universal I/O channel 3: connector pin 1 = switched sensor supply, 2 = signal, 3 = GND. Output: DAC level x 4.83 from a TSB582 section through a switch (IO Output Drivers sheet), up to 100 mA, open while OUT_EN is low."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "6b805b17-9c5a-5b5e-8b69-466a71675793")
	)
	(text "Every control line is pulled to its off level, so the channel is high impedance with the sensor supply off until firmware sets the expander."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "88bf68d7-ed25-5757-8bcf-60224869ae7b")
	)
	(text "BIAS"
		(exclude_from_sim no)
		(at 208.28 147.32 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "a232fb54-192d-51fe-9abf-1bbbb51315a6")
	)
	(text "Input: the pin through 100k to the ADC; with the 20k leg grounded (default) 15 V reads 2.5 V, with DIRECT high the range is 0-2.5 V. BURDEN adds 120 R for 4-20 mA loops; PULLUP (range switch sheet) adds 10k to +3V3."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "aa4372fa-69a4-53f6-95d7-25b254d7b900")
	)
