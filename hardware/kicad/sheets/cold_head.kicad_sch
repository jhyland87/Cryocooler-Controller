	(text "PT1000 4-wire ratiometric: IDAC1 (AIN3) excites through 1k (1.5 V at 250 uA if the cable shorts), AIN1/AIN0 sense, Rref (3.9k) on REFP0/REFN0. SPI mode 1 on the main bus (CS from the decoder), internal oscillator (CLK tied low)."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "2f389435-ae57-5f60-80ef-ed2a0b718382")
	)
	(text "DRDY goes to its test point only: firmware polls the conversion. The ESD clamp sits on the connector side of the 1k resistors; 10 nA of leakage is about 0.01 K."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "639dc913-8055-5576-8de2-7758ca071561")
	)
	(text "ADS1220 DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 241.3 116.84 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "f16df973-52f5-55ec-b96f-a8027a5e6a3c")
	)
