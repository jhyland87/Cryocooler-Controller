	(text "ADP5071 layout: keep PGND off the exposed pad on the top layer (datasheet layout section). SEQ on VREG starts both channels together when EN2 rises."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "3fa90db5-e4c7-5a74-b2f2-c8f0251316e3")
	)
	(text "ADP5071 values from datasheet Fig. 47 / Tables 9-11. LT3045 / LT3094: VOUT = 100 uA x RSET (147k = 14.7 V, +15 V is the top of the LT3045 range); PGFB dividers 432k/10k trip power good near 13.3 V (also enables fast start-up)."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "4688077b-53b8-5fa6-b256-93e1e611013c")
	)
