	)
	(text "PG1 / PG2 (open drain, high = within 4 %) and the LT3097 PGP / PGN go to the power_good sheet; GATE1/2 unused (no output disconnect)."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "677f58a5-46ca-54bb-944d-e0355a573dcd")
	)
	(text "LT8582 circuit after datasheet p.30 (5 V to +/-12 V): RT 53.6k, SS 0.1 uF, VC 6.49k+4.7nF / 14.7k+2.2nF with 47 pF. RFBX1 = (16.4 - 1.204) / 83.3 uA = 182k, RFBX2 = (16.5 + 0.007) / 83.3 uA = 198k. Inverting needs L >= 5.6 uH (duty ~0.80): 10 uH coupled MSD7342."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "9f3dc574-53d3-5167-9629-a110454112b8")
	)
