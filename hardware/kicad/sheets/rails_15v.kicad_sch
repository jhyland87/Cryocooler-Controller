	)
	(text "ADP5071 layout: keep PGND off the exposed pad on the top layer (datasheet layout section). SEQ on VREG starts both channels together when EN2 rises."
		(exclude_from_sim no)
		(at 20 27 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "5f9e4e7c-39d7-58c8-88fa-dadc2c96ecbd")
	)
	(text "ADP5071ACPZ (5 V in): +16.4 V boost and -16.5 V inverting rails; one LT3097 post-regulates them to +/-14.7 V."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "d7709a0b-0bf8-5ce8-b71d-0cf6fe6b831a")
	)
	(text "ADP5071 values from datasheet Fig. 47 / Tables 9-11. LT3097: VOUT = 100 uA x RSET (147k = 14.7 V, +15 V is the top of its range); PGFB dividers 432k/10k trip power good near 13.3 V (also enables fast start-up)."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
