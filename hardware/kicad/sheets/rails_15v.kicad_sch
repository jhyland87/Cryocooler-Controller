	(text "LT8582 (5 V in, 1.5 MHz): channel 1 boosts to +16.4 V, channel 2 inverts to -16.5 V; one LT3097 post-regulates them to +/-14.7 V."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
