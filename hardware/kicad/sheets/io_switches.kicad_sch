	(text "PULL-UP SWITCH, CHANNELS 1-4"
		(exclude_from_sim no)
		(at 38.1 121.92 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "58cbe7e3-ee0b-5978-86b5-575fa03c4b52")
	)
	(text "Pull-up: TMUX7412F on +12 V joins the pin to 10k / +3V3 while PULLUP is high. Its source pins block in both directions and survive +-60 V, so a pin above 3.3 V is not loaded while the switch is open. FF (fault flag) is not used."
		(exclude_from_sim no)
		(at 20 21 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "83691df1-b4d0-580d-941c-37e1bb1ec5d4")
	)
	(text "TMUX7412F DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 99.06 251.46 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "83ea5fa6-2286-533c-bc40-a48d8f210311")
	)
	(text "Range: TMUX1111 closes while its select is low, grounding the 20k divider leg (0-15 V range). DIRECT high opens it. The switch only ever sees the ADC-side voltage, never the pin."
		(exclude_from_sim no)
		(at 20 15 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "8b9a76ef-886c-5cff-8b8a-88f3b33d4145")
	)
	(text "TMUX1111 DECOUPLING CAPACITORS"
		(exclude_from_sim no)
		(at 38.1 251.46 0)
		(effects
			(font
				(size 1.8 1.8)
			)
			(justify left top)
		)
		(uuid "98e5c3db-598c-5b67-ba55-0bd6b6cd88db")
	)
