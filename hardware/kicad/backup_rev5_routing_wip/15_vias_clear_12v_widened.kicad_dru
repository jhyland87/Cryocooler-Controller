(version 1)

# 0.45 mm / 0.2 mm via-in-pad on 0.5 mm pitch pads leaves 0.1 mm to the
# neighbouring pad, which JLCPCB manufactures on 4 layers (copper spacing
# minimum 0.09 mm; via-in-pad must be ordered filled and capped).
(rule via_in_pad_clearance
  (condition "A.Type == 'Via' && A.Hole == 0.2mm")
  (constraint clearance (min 0.1mm)))

# ── JLCPCB 4-layer limits the board-wide settings cannot express ──
# (jlcpcb.com/capabilities/pcb-capabilities)

# plated pad holes at least 0.45 mm apart (vias: 0.2 mm, board setting)
(rule jlc_pad_hole_to_hole
  (condition "A.Type == 'Pad' && B.Type == 'Pad'")
  (constraint hole_to_hole (min 0.45mm)))

# plated through-hole pads: 0.15 mm annular ring minimum (0.2 mm recommended)
(rule jlc_pth_annular_ring
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint annular_width (min 0.15mm)))

# inner layers: 0.3 mm from a plated pad hole to other copper
(rule jlc_inner_pth_hole_clearance
  (layer inner)
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.3mm)))

# non-plated holes: 0.2 mm to any copper
(rule jlc_npth_to_copper
  (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_clearance (min 0.2mm)))

# the USB-C receptacle's own GND pads sit closer than 0.2 mm to its own
# locating holes by design (GCT land pattern; rev 4's USB4205 keeps 0.3 mm); JLCPCB builds it as is
(rule usb_c_own_holes
  (condition "A.memberOfFootprint('J1') && B.memberOfFootprint('J1')")
  (constraint hole_clearance (min 0mm)))

# Last stuck nets: 0.1 mm (JLCPCB 4-layer minimum is 0.09 mm), approved by the user 2026-11-16
(rule tight_last_nets
  (condition "A.NetName == 'IO3_PULLUP' || A.NetName == 'IO1_DIRECT' || A.NetName == 'RS485_CS' || A.NetName == 'SPI_MOSI' || A.NetName == '/IO Output Drivers/IO4_DRV' || A.NetName == 'Net-(U22-SET)' || A.NetName == 'IO3_SENS_EN' || A.NetName == '/Amp Control/AMP_REM_LED' || A.NetName == 'IO2_DIV' || A.NetName == 'IO1_BURDEN' || A.NetName == 'IO1_PULLUP' || A.NetName == 'IO1_ADC' || A.NetName == 'IO2_DAC' || A.NetName == 'IO2_DIRECT' || A.NetName == 'IO3_BURDEN' || A.NetName == 'IO3_DAC' || A.NetName == 'IO3_OUT_EN' || A.NetName == 'IO3_PIN' || A.NetName == 'IO4_DIRECT' || A.NetName == 'IO4_OUT_EN' || A.NetName == 'IO4_PIN' || A.NetName == 'IO1_DAC' || A.NetName == 'IO1_DIV' || A.NetName == 'IO4_SENS_FLT_N' || A.NetName == 'EXP_INT_N' || A.NetName == 'IO4_PULLUP' || A.NetName == 'RS485_IRQ_N' || A.NetName == 'IO3_DIRECT' || A.NetName == 'IO4_DAC' || A.NetName == 'AUX_IO7' || A.NetName == 'IO2_PIN' || A.NetName == 'IO3_SENS_FLT_N' || A.NetName == 'IO4_DIV' || A.NetName == '/IO Channel 2/IO2_BUF' || A.NetName == 'IO2_ADC' || A.NetName == 'IO4_SENS_EN' || A.NetName == 'IO1_PIN' || A.NetName == 'IO2_BUF_OE_N' || A.NetName == 'IO2_PULLUP' || A.NetName == 'IO2_SENS_EN' || A.NetName == 'IO_OUT_FLT_A_N'")
  (constraint clearance (min 0.1mm)))

(rule tight_moved_h
  (condition "A.NetName == 'IO1_SENS_EN' || A.NetName == 'IO1_PULLUP' || A.NetName == 'IO4_OUT_EN' || A.NetName == '/IO Output Drivers/IO4_DRV'")
  (constraint clearance (min 0.1mm)))

(rule tight_12v_links
  (condition "A.NetName == '+12V'")
  (constraint clearance (min 0.1mm)))

(rule tight_moved_v
  (condition "A.NetName == 'IO1_DAC' || A.NetName == 'IO2_PIN' || A.NetName == 'IO2_PULLUP' || A.NetName == 'IO3_DAC' || A.NetName == 'IO3_PIN' || A.NetName == 'IO3_PULLUP' || A.NetName == 'Net-(U103A--)' || A.NetName == 'Net-(U106-D2)'")
  (constraint clearance (min 0.1mm)))
