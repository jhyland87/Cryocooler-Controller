(version 1)

# 0.45 mm / 0.2 mm via-in-pad on 0.5 mm pitch pads leaves 0.1 mm to the
# neighbouring pad, which JLCPCB manufactures on 4 layers (copper spacing
# minimum 0.09 mm; via-in-pad must be ordered filled and capped). Pads only:
# a via keeps the full 0.15 mm from tracks and other vias (rev 6).
(rule via_in_pad_clearance
  (condition "A.Type == 'Via' && A.Hole == 0.2mm && B.Type == 'Pad'")
  (constraint clearance (min 0.1mm)))

# ── JLCPCB 4-layer limits the board-wide settings cannot express ──
# (jlcpcb.com/capabilities/pcb-capabilities)

# plated pad holes at least 0.45 mm apart (vias: 0.2 mm, board setting)
(rule jlc_pad_hole_to_hole
  (condition "A.Type == 'Pad' && B.Type == 'Pad'")
  (constraint hole_to_hole (min 0.45mm)))

# plated through-hole pads: 0.15 mm annular ring minimum (0.2 mm recommended)
(rule jlc_pth_annular_ring
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint annular_width (min 0.15mm)))

# inner layers: 0.3 mm from a plated pad hole to other copper
(rule jlc_inner_pth_hole_clearance
  (layer inner)
  (condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
  (constraint hole_clearance (min 0.3mm)))

# non-plated holes: 0.2 mm to any copper
(rule jlc_npth_to_copper
  (condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
  (constraint hole_clearance (min 0.2mm)))

# the USB-C receptacle's own GND pads sit closer than 0.2 mm to its own
# locating holes by design (GCT land pattern; rev 4's USB4205 keeps 0.3 mm); JLCPCB builds it as is
(rule usb_c_own_holes
  (condition "A.memberOfFootprint('J1') && B.memberOfFootprint('J1')")
  (constraint hole_clearance (min 0mm)))

# Isolated side (0-120 VAC amplifier output through the ACS37800, ISO_GND, ISO_5V and
# the isolator's outputs): 1.5 mm to everything on the logic side, the width of the
# keep-out band round the island. Not a certified creepage figure (DESIGN_REVIEW.md);
# the unconnected pads of D10 are left out.
(rule iso_barrier
  (condition "(A.NetName == 'ISO_GND' || A.NetName == 'ISO_5V' || A.NetName == 'Net-(J11-Pin_1)' || A.NetName == 'Net-(J12-Pin_1)' || A.NetName == 'Net-(U18-VINP)' || A.NetName == '/Debug/ISO_5V_LED_A' || A.NetName == 'Net-(R64-Pad2)' || A.NetName == 'Net-(R65-Pad2)' || A.NetName == 'Net-(R66-Pad2)' || A.NetName == 'Net-(U17-IND)' || A.NetName == 'Net-(U17-OUTA)' || A.NetName == 'Net-(U17-OUTB)' || A.NetName == 'Net-(U17-OUTC)') && !(B.NetName == 'ISO_GND' || B.NetName == 'ISO_5V' || B.NetName == 'Net-(J11-Pin_1)' || B.NetName == 'Net-(J12-Pin_1)' || B.NetName == 'Net-(U18-VINP)' || B.NetName == '/Debug/ISO_5V_LED_A' || B.NetName == 'Net-(R64-Pad2)' || B.NetName == 'Net-(R65-Pad2)' || B.NetName == 'Net-(R66-Pad2)' || B.NetName == 'Net-(U17-IND)' || B.NetName == 'Net-(U17-OUTA)' || B.NetName == 'Net-(U17-OUTB)' || B.NetName == 'Net-(U17-OUTC)') && B.NetName != '' && B.NetName != 'unconnected-(D10-RK-Pad3)' && B.NetName != 'unconnected-(D10-RA-Pad4)'")
  (constraint clearance (min 1.5mm)))

# Amplifier line to its return: J11 / J12 pin 1 (the two ends of U18's current conductor, so no rule
# between them) and the three high-side divider nodes (R64-R66 pad 2) against ISO_GND, 1.25 mm on all
# layers. IPC-2221 uncoated-external figure for 0-120 VAC, from memory, not checked (user-approved
# 2026-11-23). The low-side node Net-(U18-VINP) is left out: R63 and U18 pins 15 / 16 sit closer.
(rule iso_line_to_return
  (condition "(A.NetName == 'ISO_GND' && (B.NetName == 'Net-(J11-Pin_1)' || B.NetName == 'Net-(J12-Pin_1)' || B.NetName == 'Net-(R64-Pad2)' || B.NetName == 'Net-(R65-Pad2)' || B.NetName == 'Net-(R66-Pad2)')) || (B.NetName == 'ISO_GND' && (A.NetName == 'Net-(J11-Pin_1)' || A.NetName == 'Net-(J12-Pin_1)' || A.NetName == 'Net-(R64-Pad2)' || A.NetName == 'Net-(R65-Pad2)' || A.NetName == 'Net-(R66-Pad2)'))")
  (constraint clearance (min 1.25mm)))
