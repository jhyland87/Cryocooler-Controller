	(text "6A1_V15_OUT: V15 output node - no signal name printed on 6A-1.\nOn 6A-2 the same node of V16 leaves the page as REF_2."
		(exclude_from_sim no)
		(at 299.72 378.46 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "5391b3eb-bedc-54bd-a81c-d4f5a346844a")
	)
	(text "Supplies printed lower-case: +12v, -12v, +15v, -15v."
		(exclude_from_sim no)
		(at 299.72 396.24 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "83ce5917-a5d0-5172-b4b0-8ba39331933f")
	)
	(text "Every LTC1150 pin 8 and the common pin-6 bus end in off-page connectors that\nare ALL printed \"CBY_1\" (6A-1 and 6A-2) - drawn as one net here, as printed.\nProbable drafting error (each channel output presumably had its own name)."
		(exclude_from_sim no)
		(at 299.72 332.74 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "96731e3b-8813-5276-a71b-dd8524b062ae")
	)
	(text "J pin 2 is printed \"POLARIZING_KEY\" (keyed position) on every channel.\nJ pin 3 is drawn tied to GND on every channel.\nLTC1150 pin 5 is drawn as an unconnected stub on every channel."
		(exclude_from_sim no)
		(at 299.72 355.6 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "c8200be6-4fe7-5b64-9b2d-06d9f40950db")
	)
