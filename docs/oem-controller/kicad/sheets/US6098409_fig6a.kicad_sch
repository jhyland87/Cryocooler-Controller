	(text "FIG 6A - Sensor amplifiers J1-J7, REF buffers\nSource: US6098409 sheets 21-22 of 25 (PDF p22-23), FIG 6A-1/6A-2"
		(exclude_from_sim no)
		(at 15 18 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left top)
		)
		(uuid "24f5bfa2-83ac-5857-80d9-175f937af686")
	)
	(text "Every LTC1150 pin 8 and the common pin-6 bus end in off-page connectors that\nare ALL printed \"CBY_1\" (6A-1 and 6A-2) - drawn as one net here, as printed.\nProbable drafting error (each channel output presumably had its own name)."
		(exclude_from_sim no)
		(at 299.72 332.74 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "36cd202d-9e83-5398-8bb9-052bb20fc64d")
	)
	(text "J pin 2 is printed \"POLARIZING_KEY\" (keyed position) on every channel.\nJ pin 3 is drawn tied to GND on every channel.\nLTC1150 pin 5 is drawn as an unconnected stub on every channel."
		(exclude_from_sim no)
		(at 299.72 355.6 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "397b0bc7-6d79-52f9-952c-3099d626f7e4")
	)
	(text "Supplies printed lower-case: +12v, -12v, +15v, -15v."
		(exclude_from_sim no)
		(at 299.72 396.24 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "3f254ae6-7c87-5dc4-823c-7640af92dad6")
	)
	(text "FIG 6A-1 (left)  |  FIG 6A-2 (right)"
		(exclude_from_sim no)
		(at 254 27.94 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "5537aa62-31ea-5b42-87f5-8695bb443af2")
	)
	(text "6A1_V15_OUT: V15 output node - no signal name printed on 6A-1.\nOn 6A-2 the same node of V16 leaves the page as REF_2."
		(exclude_from_sim no)
		(at 299.72 378.46 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "a613d896-4208-5602-a2e6-4aa0ffc349af")
	)
