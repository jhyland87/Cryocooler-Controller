	(text "FIG 6B - Sensor amplifiers J8-J14, REF buffers\nSource: US6098409 sheets 23-24 of 25 (PDF p24-25), FIG 6B-1/6B-2"
		(exclude_from_sim no)
		(at 15 18 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left top)
		)
		(uuid "78723a71-ed1a-5bc7-ab58-5087073ac0d3")
	)
	(text "REF_4 = V17 out + V18 out: the V17 output line runs off the top of 6B-1 into 6B-2,\nwhere it is annotated \"REF_3\", feeds R64/R67 and joins the V18 output (label REF_4).\nTwo LT1007 outputs drawn shorted; printed name REF_3 is on this same conductor."
		(exclude_from_sim no)
		(at 299.72 350.52 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "a74e63fb-15ab-568d-83e8-39d4ed92bd66")
	)
	(text "Every LTC1150 pin 8 and the common pin-6 bus end in off-page connectors that\nare ALL printed \"CBY_1\" - drawn as one net here, as printed (probable drafting error).\nJ8: R39/R42 reference node also drawn to a CBY_1 connector (crosses the V17 line, no junction)."
		(exclude_from_sim no)
		(at 299.72 327.66 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "b9b7560b-8672-5502-a9e2-6ec4fde42388")
	)
	(text "FIG 6B-1 (left)  |  FIG 6B-2 (right)"
		(exclude_from_sim no)
		(at 254 27.94 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "c157c0c9-ffbd-51ae-b8ed-dd04390e8bd0")
	)
	(text "Supplies printed lower-case: +12v, -12v, +15v, -15v."
		(exclude_from_sim no)
		(at 299.72 396.24 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "d5aade07-a76c-5ab9-ac97-2267161569df")
	)
	(text "J pin 2 printed \"POLARIZING_KEY\"; J pin 3 drawn tied to GND; LTC1150 pin 5 drawn as\nan unconnected stub (omitted). J10 here is a sensor input; FIG 6C reuses J10 (26-pin)."
		(exclude_from_sim no)
		(at 299.72 373.38 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
