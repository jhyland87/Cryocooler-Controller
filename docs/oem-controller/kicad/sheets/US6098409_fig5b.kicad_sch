	(text "FIG 5B - CS_CTRL loop, NSP pots, OF_SET\nSource: US6098409 sheet 5 of 25 (PDF p6), FIG 5B"
		(exclude_from_sim no)
		(at 15 18 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left top)
		)
		(uuid "1f76ce75-1ffd-5dfa-a907-c19bf0d1a87f")
	)
	(text "NSP lines -> POT (U36 pot, U54 buffer -> OF_SET, OF_OFFSET) and LATCH (U29 -> CST_DEL, RAW_SHUTO_T-).\nCST_2 / CST_1 -> SWITCH (U43, on CST_DEL) -> SUM (U42, with OF_SET and +10V) -> INTEG (U35) -> CS_CTRL.\nSignal roles are inferred; the patent text does not describe FIG 5B."
		(exclude_from_sim no)
		(at 19.05 158.75 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "a3ddc83d-c19c-5051-964a-67875cb0b3b0")
	)
