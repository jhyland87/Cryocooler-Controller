	(text "FIG 5C - Set-point sum, overstroke back-off\nOverstroke back-off counter (U28, C71)\nSource: US6098409 sheets 6-7 of 25 (PDF p7-8), FIG 5C-1 + FIG 5C-2"
		(exclude_from_sim no)
		(at 15 18 0)
		(effects
			(font
				(size 2.5 2.5)
			)
			(justify left top)
		)
		(uuid "1aa53755-7048-563e-a931-ad18427d73d9")
	)
	(text "OVERSTROKE BACK-OFF COUNTER (U28, C71)"
		(exclude_from_sim no)
		(at 27.94 45.72 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "7a70eefb-da15-5a2e-a9ff-5a4a22747a29")
	)
	(text "OVERSTROKE BACK-OFF COUNTER (inferred, analysis/OVERSTROKE.md 2.3): each U48 trip fires U28 (pin 2 O):\nQ5 off, R167 charges C71 through Q4 (JFET diode). U28 (pin 10 O) is retriggered by each trip and holds\nQ1 off; after about R145*C72 with no trips Q1 bleeds C71 through R130. SHUTO_T low clears both one-shots\nand turns Q2 off, so R190/R142 set C71 through Q3. SHUTO_T is printed as an off-page flag; its source is\nnot on the transcribed pages."
		(exclude_from_sim no)
		(at 19.05 203.2 0)
		(effects
			(font
				(size 1.5 1.5)
			)
			(justify left top)
		)
		(uuid "e6b02aed-18ca-5114-865d-bd8601bf8ec4")
	)
