        <mxCell id="title" value="&lt;b&gt;SuperFilter - Cool-Down State Table (Table 9) as a state machine&lt;/b&gt;&lt;br&gt;&lt;i&gt;SuperFilter Operation/Install Guide 830-0010A PDF p33 (Table 9), p32, p14-15, p62, p65&lt;/i&gt;" style="text;html=1;align=left;verticalAlign=top;whiteSpace=wrap;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="10" y="-70" width="900" height="40" as="geometry" />
