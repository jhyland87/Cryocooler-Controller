        </mxCell>
        <mxCell id="s0" value="&lt;b&gt;0 Initialize&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Relay: Bypass&lt;br&gt;FAULT On**, READY Off**&lt;br&gt;Initial power up state" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="10" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s1" value="&lt;b&gt;1 Idle&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Relay: Bypass&lt;br&gt;FAULT On RED, READY Off&lt;br&gt;Cold stage warm, Dewar not cooling" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="430" y="10" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="&lt;b&gt;2 Coarse Cool-down&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Relay: Bypass&lt;br&gt;FAULT Fast flash RED, READY Off&lt;br&gt;Cooling, cold stage above 85 K" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="790" y="10" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="&lt;b&gt;3 Fine Cool-down&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Relay: Bypass&lt;br&gt;FAULT Fast RED, READY Slow GREEN&lt;br&gt;Cooling, cold stage below 85 K" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="1150" y="10" width="240" height="110" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="&lt;b&gt;4 Over shoot&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Relay: Bypass&lt;br&gt;FAULT Fast RED, READY Fast GREEN&lt;br&gt;Colder than set point (nom. 78 K);&lt;br&gt;integrator settling" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=6;fontSize=10;fillColor=#fff2cc;strokeColor=#d6b656;" vertex="1" parent="1">
          <mxGeometry x="70" y="240" width="240" height="110" as="geometry" />
