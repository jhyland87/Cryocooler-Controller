        <mxCell id="s5" value="&lt;b&gt;5 Settle&lt;/b&gt;&lt;hr size=&quot;1&quot;&gt;Relay: Normal&lt;br&gt;FAULT Fast RED, READY Fast GREEN&lt;br&gt;Temp settling; circuits switched&lt;br&gt;to Normal" style="rounded=1;whiteSpace=wrap;html=1;arcSize=20;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;arcSize=6;fontSize=10;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1">
